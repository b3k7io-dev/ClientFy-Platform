# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Server-side YouTube Data API v3 key for channel search.
YOUTUBE_API_KEY=

# ADMIN_PASSWORD: Optional server-side admin passcode (overrides claimed admin setup).
ADMIN_PASSWORD=

# TELEGRAM_BOT_TOKEN: Token from @BotFather for Telegram Stars payments and bot commands.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_BOT_USERNAME: Optional bot username without @ (auto-detected via getMe when running).
TELEGRAM_BOT_USERNAME=

# OWNER_ID: Telegram user ID of bot owner/admin for payment approvals and /admin access.
OWNER_ID=

# BOT_MODE: "polling" (default) or "webhook"
BOT_MODE=polling

# WEBAPP_URL: Optional HTTPS URL opened by the Telegram Bot WebApp button (defaults to APP_URL)
WEBAPP_URL=

# SKIP_BOT_POLLING: Set "true" if running the grammY bot separately on another process/server
SKIP_BOT_POLLING=false

# TELEGRAM_API_ID / TELEGRAM_API_HASH: MTProto credentials from my.telegram.org for real userbot outreach
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# TON_WALLET_ADDRESS / GRAM_WALLET_ADDRESS / VISA_CARD_DETAILS: Optional default payment wallets
TON_WALLET_ADDRESS=
GRAM_WALLET_ADDRESS=
VISA_CARD_DETAILS=

# SUPPORT_URL: Support link in Telegram bot and WebApp (defaults to https://t.me/ClienFy_Support)
SUPPORT_URL=https://t.me/ClienFy_Support

# SESSION_SECRET / SESSION_ENCRYPTION_KEY: Recommended random 32+ char strings in production
SESSION_SECRET=
SESSION_ENCRYPTION_KEY=
